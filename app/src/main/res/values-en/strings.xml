    <string name="faq_title">Frequently Asked Questions</string>
    <string name="faq_q1">How do I add a subject?</string>
    <string name="faq_a1">Go to the Subjects tab and press the + button to add a new subject.</string>
    <string name="faq_q2">How do I calculate my final grade?</string>
    <string name="faq_a2">Use the Final Grade calculator from the main menu.</string>
    <string name="faq_q3">Is my data saved in the cloud?</string>
    <string name="faq_a3">Your data is synced with Firebase when you log in.</string>
    <string name="faq_q4">Can I use Gradia without internet?</string>
    <string name="faq_a4">Yes, your data is stored locally and will sync when you have a connection.</string>
    <string name="faq_q5">How do I delete my account?</string>
    <string name="faq_a5">Go to Profile and select the delete account option.</string>

    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_body">At Gradia, we value your privacy. The academic data you enter (grades, subjects, goals) is stored locally on your device and, if you use synchronization, on protected Firebase servers.\n\nWe do not sell or share your personal academic information with third parties. We may collect anonymous usage data to improve the app experience.\n\nYou can request the deletion of your data at any time by contacting soporte@gradia.app.</string>

